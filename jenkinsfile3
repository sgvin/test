pipeline {
    agent any
    stages {
        stage('Parallel Execution') {  // Wrap parallel execution inside a single stage
            parallel {
                stage('Build Stage') {
                    steps {
                        echo "This is build stage"
                        sh 'sleep 5'
                    }
                }
                stage('Nested Parallel Stage') {
                    parallel {
                        stage('Deploy 1') {
                            steps {
                                echo "This is deploy 1"
                                sh 'sleep 5'
                            }
                        }
                        stage('Deploy 2') {
                            steps {
                                echo "This is deploy 2"
                                sh 'sleep 5'
                            }
                        }
                        stage('Deploy 3') {
                            steps {
                                echo "This is deploy 3"
                                sh 'sleep 5'
                            }
                        }
                    }
                }
            }
        }
        stage('Test Stage') {
            steps {
                echo "This is test stage"
                sh 'sleep 5'
            }
        }
    }
}
