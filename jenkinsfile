pipeline {
    agent any
    stages {
       stage('Build stage') {
          steps {
             echo "This is build stage"
             sh 'sleep 5'
          }
       }
       stage('Deploy Stage') {
          steps {
             echo "This is Deploy stage"
             sh 'sleep 5'
          }
       }
       stage('Test Stage') {
           steps {
               echo "this is test stage"
               sh 'sleep 5'
           }
       }
   }
}
